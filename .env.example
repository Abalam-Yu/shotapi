# Copy to .env.local. Local defaults work without this file:
# demo mode is on when VERCEL is unset, and the demo key below is seeded.

# 1 turns the public demo key and /api/v1/demo/render on.
# 0 turns them off. Unset = on locally, off on Vercel.
SHOTAPI_DEMO=1
SHOTAPI_DEMO_KEY=sk_demo_local_dev_only

# Required only for the operator route POST /api/v1/keys (demo or pro).
# Public Free keys use POST /api/v1/keys/free and do not read this value.
SHOTAPI_ADMIN_TOKEN=

# Public Free mint. Unset or 1 is on. 0 returns 404 free_keys_disabled.
SHOTAPI_FREE_KEYS=1
# Per client IP, per optional email, cooldown, and public caps.
# Windows are seconds. Cooldown 0 disables the per-IP pause.
# Upstash shares these counters. Without it they reset with the process.
SHOTAPI_FREE_KEY_IP_LIMIT=5
SHOTAPI_FREE_KEY_IP_WINDOW_SEC=86400
SHOTAPI_FREE_KEY_EMAIL_LIMIT=5
SHOTAPI_FREE_KEY_EMAIL_WINDOW_SEC=86400
SHOTAPI_FREE_KEY_COOLDOWN_SEC=15
SHOTAPI_FREE_KEY_GLOBAL_LIMIT=1000
SHOTAPI_FREE_KEY_GLOBAL_WINDOW_SEC=3600
SHOTAPI_FREE_KEY_DAILY_LIMIT=5000
SHOTAPI_FREE_KEY_DAILY_WINDOW_SEC=86400

# file store directory (local / single process). Ignored on Vercel unless you
# opt into a non-persistent disk with SHOTAPI_ALLOW_FILE_STORE=1.
SHOTAPI_DATA_DIR=.data

# Upstash Redis REST. When both are set, usage survives serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monthly successful renders per key.
SHOTAPI_QUOTA_DEMO=100
SHOTAPI_QUOTA_PRO=10000

# auto | chrome | sparticuz
# auto = chrome off Vercel, @sparticuz/chromium on Vercel.
RENDER_DRIVER=auto
# Absolute path to Chrome/Chromium when RENDER_DRIVER=chrome.
CHROME_PATH=
# Default is no sandbox so Chrome can start in containers. Set 0 on a desktop.
SHOTAPI_CHROME_NO_SANDBOX=1
# Set 1 only for local testing against localhost or a private network.
ALLOW_PRIVATE_URLS=0

RENDER_TIMEOUT_MS=25000
SHOTAPI_MAX_HTML_BYTES=500000
SHOTAPI_MAX_BODY_BYTES=1000000

# Public origin used for checkout return URLs. Falls back to the request origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown on the legal pages and the site footer. Defaults to support@shotapi.dev.
NEXT_PUBLIC_SUPPORT_EMAIL=support@shotapi.dev

# Optional CORS allow-origin for the API. Defaults to *.
SHOTAPI_CORS_ORIGIN=*

# Billing provider: creem | paddle | stripe | demo
# Unset picks creem when CREEM_API_KEY is set, otherwise stripe when
# STRIPE_SECRET_KEY is set, otherwise demo. Paddle checkout is not implemented.
BILLING_PROVIDER=

# Creem is the primary live processor (merchant of record).
# CREEM_TEST_MODE=1 sends checkout to https://test-api.creem.io. Use a test API key.
# Webhook URL: https://shotapi-three.vercel.app/api/v1/billing/webhook/creem
# Subscribe to checkout.completed, subscription.paid, subscription.canceled, subscription.expired.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID=
CREEM_TEST_MODE=0

# Stripe sandbox fallback. Leave blank unless BILLING_PROVIDER=stripe,
# or Creem is unset and you still want the Stripe test path.
# STRIPE_PRICE_ID must be a recurring price. The Billing Meter, if used,
# should accept payload keys stripe_customer_id and value (or the overrides).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_METER_EVENT_NAME=
STRIPE_METER_CUSTOMER_PAYLOAD_KEY=stripe_customer_id
STRIPE_METER_VALUE_PAYLOAD_KEY=value
